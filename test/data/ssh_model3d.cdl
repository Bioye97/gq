netcdf ssh_model3d {
dimensions:
	z = 3 ;
	y = 4 ;
	x = 5 ;
variables:
	double z(z) ;
		z:axis = "Z" ;
		z:positive = "up" ;
	double y(y) ;
		y:axis = "Y" ;
	double x(x) ;
		x:axis = "X" ;
	float vp(z, y, x) ;
		vp:units = "m s-1" ;
	float marker(z, y, x) ;
data:
	z = 0, 1, 2 ;
	y = 0, 1, 2, 3 ;
	x = 0, 1, 2, 3, 4 ;
	vp = 2000, 2000, 2000, 2000, 2000,
	     2000, 2000, 2000, 2000, 2000,
	     2000, 2000, 2000, 2000, 2000,
	     2000, 2000, 2000, 2000, 2000,
	     2000, 2000, 2000, 2000, 2000,
	     2000, 2000, 2000, 2000, 2000,
	     2000, 2000, 2000, 2000, 2000,
	     2000, 2000, 2000, 2000, 2000,
	     2000, 2000, 2000, 2000, 2000,
	     2000, 2000, 2000, 2000, 2000,
	     2000, 2000, 2000, 2000, 2000,
	     2000, 2000, 2000, 2000, 2000 ;
	marker = 9, 9, 9, 9, 9,
	         9, 9, 9, 9, 9,
	         9, 9, 9, 9, 9,
	         9, 9, 9, 9, 9,
	         9, 9, 9, 9, 9,
	         9, 9, 9, 9, 9,
	         9, 9, 9, 9, 9,
	         9, 9, 9, 9, 9,
	         9, 9, 9, 9, 9,
	         9, 9, 9, 9, 9,
	         9, 9, 9, 9, 9,
	         9, 9, 9, 9, 9 ;
}
