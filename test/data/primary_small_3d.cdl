netcdf primary_small_3d {
dimensions:
	z = 2 ;
	y = 2 ;
	x = 2 ;
variables:
	double z(z) ;
		z:axis = "Z" ;
		z:units = "km" ;
	double y(y) ;
		y:axis = "Y" ;
		y:units = "km" ;
	double x(x) ;
		x:axis = "X" ;
		x:units = "km" ;
	float vp(z, y, x) ;
		vp:units = "km/s" ;
data:
	z = 1, 2 ;
	y = 1, 2 ;
	x = 1, 2 ;
	vp = 10, 10, 10, 10, 10, 10, 10, 10 ;
}
