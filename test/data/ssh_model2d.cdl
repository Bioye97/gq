netcdf ssh_model2d {
dimensions:
	y = 5 ;
	x = 7 ;
variables:
	double y(y) ;
		y:axis = "Y" ;
	double x(x) ;
		x:axis = "X" ;
	float vp(y, x) ;
		vp:long_name = "P-wave velocity" ;
		vp:units = "m s-1" ;
	float vs(y, x) ;
		vs:long_name = "S-wave velocity" ;
		vs:units = "m s-1" ;
	float quality(y, x) ;
		quality:long_name = "unselected quality" ;
data:
	y = 0, 1, 2, 3, 4 ;
	x = 0, 1, 2, 3, 4, 5, 6 ;
	vp = 1000, 1000, 1000, 1000, 1000, 1000, 1000,
	     1000, 1000, 1000, 1000, 1000, 1000, 1000,
	     1000, 1000, 1000, 1000, 1000, 1000, 1000,
	     1000, 1000, 1000, 1000, 1000, 1000, 1000,
	     1000, 1000, 1000, 1000, 1000, 1000, 1000 ;
	vs = 500, 500, 500, 500, 500, 500, 500,
	     500, 500, 500, 500, 500, 500, 500,
	     500, 500, 500, 500, 500, 500, 500,
	     500, 500, 500, 500, 500, 500, 500,
	     500, 500, 500, 500, 500, 500, 500 ;
	quality = 7, 7, 7, 7, 7, 7, 7,
	          7, 7, 7, 7, 7, 7, 7,
	          7, 7, 7, 7, 7, 7, 7,
	          7, 7, 7, 7, 7, 7, 7,
	          7, 7, 7, 7, 7, 7, 7 ;
}
